{
  "log": {
    "level": "warn",
    "timestamp": true
  },
  "inbounds": [
    {
      "type": "vless",
      "tag": "ru-in",
      "listen": "::",
      "listen_port": {{.ListenPort}},
      "users": [
        {
          "uuid": "{{.UUID}}",
          "flow": "xtls-rprx-vision"
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "{{.SNI}}",
        "reality": {
          "enabled": true,
          "handshake": {
            "server": "{{.SNI}}",
            "server_port": 443
          },
          "private_key": "{{.PrivateKey}}",
          "short_id": ["{{.ShortID}}"]
        }
      }
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "final": "direct"
  }
}
